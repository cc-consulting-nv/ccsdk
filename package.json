{
  "name": "@cc-consulting-nv/ccsdk",
  "version": "1.2.1",
  "description": "Closed Circuit platform SDK — typed client, caching, paginated APIs.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "lint": "echo \"lint not configured for sdk\"",
    "test": "pnpm build && node --loader ./tests/extension-loader.mjs --test $(ls tests/*.test.js)",
    "test:coverage": "pnpm build && npx c8 --reporter=text --include='dist/**' --exclude='dist/index.js' --extensions '.ts' -- node --loader ./tests/extension-loader.mjs --test $(ls tests/*.test.js)",
    "test:integration": "tsx tests/integration/integration.js",
    "test:integration:business": "tsx tests/integration/business-crud.integration.js",
    "docs": "typedoc --options typedoc.html.json",
    "docs:html": "typedoc --options typedoc.html.json",
    "docs:md": "typedoc --options typedoc.md.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cc-consulting-nv/ccsdk.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "sdk",
    "api",
    "closedcircuit",
    "tanstack-query",
    "dexie",
    "offline-first"
  ],
  "author": "ClosedCircuit",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/cc-consulting-nv/ccsdk/issues"
  },
  "homepage": "https://github.com/cc-consulting-nv/ccsdk#readme",
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@tanstack/query-core": "5.100.14",
    "dexie": "^4.2.1",
    "laravel-echo": "^2.3.4",
    "pusher-js": "^8.5.0"
  },
  "devDependencies": {
    "c8": "^11.0.0",
    "fake-indexeddb": "^6.2.5",
    "fake-xml-http-request": "^2.1.2",
    "rimraf": "^5.0.5",
    "tsx": "^4.22.4",
    "typedoc": "^0.28.15",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.6.3"
  }
}
